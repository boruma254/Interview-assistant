{
  "name": "interview-companion",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform desktop voice and chat assistant for permitted interview support and practice.",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "openai": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron-builder": "^26.0.12",
    "electron": "^45.1.0",
    "electron-vite": "^3.0.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.7.2",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  },
  "build": {
    "appId": "com.interviewcompanion.desktop",
    "productName": "Interview Companion",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Interview Companion uses the microphone only when you start a recording."
      }
    },
    "win": {
      "target": "nsis"
    }
  },
  "allowScripts": {
    "electron@45.1.0": true
  }
}
